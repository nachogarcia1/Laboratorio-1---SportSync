# Variables para Docker Compose (docker-compose.yml). Copiá este archivo a `.env` en la raíz del repo.
# `.env` está en .gitignore y NO se sube al repo.
# Las variables del backend cuando lo corrés fuera de Docker van en backend/.env (ver backend/.env.example).

# === Postgres ===
# POSTGRES_PASSWORD es obligatoria: sin ella `docker compose up` falla.
# Ojo: Postgres solo usa estos valores la PRIMERA vez que crea el volumen. Si ya tenés datos con otra
# contraseña, mantené la misma o recreá el volumen (`docker compose down -v`, borra los datos).
POSTGRES_DB=sport_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === Backend en Docker ===
# Perfil dev: secreto JWT de prueba, pagos simulados y código de verificación en los logs.
# Para un entorno compartido, borrá esta línea y definí JWT_SECRET.
SPRING_PROFILES_ACTIVE=dev
# Obligatorio si NO usás el perfil dev (mínimo 32 caracteres). Generá uno: openssl rand -base64 48
# JWT_SECRET=
