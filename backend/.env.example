# Plantilla de variables de entorno del backend (cuando lo corrés fuera de Docker).
# Copiá este archivo a `backend/.env` y completá los valores reales.
# `.env` está en .gitignore y NO se sube al repo.
# Se leen al arrancar: reiniciá el backend después de cambiarlas.
# Para Docker Compose las variables van en el `.env` de la raíz (ver ../.env.example).

# === Perfil ===
# dev = desarrollo local: secreto JWT de prueba, pagos simulados y código de verificación en consola.
# Sin el perfil dev la app exige JWT_SECRET y no simula pagos. NUNCA uses dev en un servidor compartido.
spring.profiles.active=dev

# === Base de datos (obligatoria, sin valores por defecto) ===
DB_URL=jdbc:postgresql://localhost:5434/sport_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# === JWT ===
# OBLIGATORIO fuera del perfil dev. Mínimo 32 caracteres; si falta o es corto, la app no arranca.
# Generá uno: openssl rand -base64 48
# En dev podés dejarlo comentado (se usa un secreto de prueba).
# JWT_SECRET=

# === SMTP (verificación de email) ===
# Gmail: requiere verificación en dos pasos y una "contraseña de aplicación" de 16 caracteres.
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  (MAIL_USERNAME y MAIL_FROM = la misma cuenta)
# Si MAIL_USERNAME queda vacío y VERIF_DEV_LOG=true (perfil dev), el código se imprime en la consola.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Imprime el código de verificación en consola cuando no hay SMTP. true en dev; false por defecto fuera de dev.
# VERIF_DEV_LOG=true

# === Google OAuth ===
GOOGLE_OAUTH_CLIENT_ID=

# === Mercado Pago ===
# Access token de sandbox (TEST-...). Sin token, MP queda deshabilitado y solo se puede pagar con tarjeta.
# MP_ACCESS_TOKEN=
# URL pública (ngrok) a la que Mercado Pago manda el webhook.
# MP_WEBHOOK_URL=
# Base del frontend para las back_urls (a dónde vuelve el usuario tras pagar).
FRONTEND_URL=http://localhost:5173
# Fuerza el checkout simulado. SOLO tiene efecto con el perfil dev.
# PAGOS_SIMULACION=true
